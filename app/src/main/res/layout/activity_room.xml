<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ui2_bg_screen"
    android:orientation="vertical">

    <include
        android:id="@+id/room_header"
        layout="@layout/comp_top_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/ui2_panel_glass"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/multiplayer_room_code_label"
                    android:textColor="@color/ui2_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/room_code_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/ui2_accent"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/multiplayer_room_owner_label"
                    android:textColor="@color/ui2_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/room_owner_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/ui2_title"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/multiplayer_room_status_label"
                    android:textColor="@color/ui2_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/room_status_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/ui2_title"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/room_status_detail_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/ui2_body"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/multiplayer_room_players_label"
                    android:textColor="@color/ui2_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/room_self_state_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/ui2_title"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/room_opponent_state_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/ui2_title"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/multiplayer_room_connection_label"
                    android:textColor="@color/ui2_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/room_connection_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/ui2_title"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/multiplayer_room_difficulty_label"
                    android:textColor="@color/ui2_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/room_difficulty_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/ui2_title"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <ToggleButton
                        android:id="@+id/button_room_difficulty_easy"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:textOff="@string/difficulty_easy"
                        android:textOn="@string/difficulty_easy" />

                    <ToggleButton
                        android:id="@+id/button_room_difficulty_normal"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginHorizontal="6dp"
                        android:layout_weight="1"
                        android:textOff="@string/difficulty_normal"
                        android:textOn="@string/difficulty_normal" />

                    <ToggleButton
                        android:id="@+id/button_room_difficulty_hard"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_weight="1"
                        android:textOff="@string/difficulty_hard"
                        android:textOn="@string/difficulty_hard" />
                </LinearLayout>

                <Button
                    android:id="@+id/button_room_ready"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="18dp"
                    android:background="@drawable/ui2_button_chip"
                    android:text="@string/multiplayer_ready_room"
                    android:textAllCaps="false"
                    android:textColor="@color/ui2_title" />

                <Button
                    android:id="@+id/button_room_sync"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/ui2_button_chip"
                    android:text="@string/multiplayer_sync_state"
                    android:textAllCaps="false"
                    android:textColor="@color/ui2_title" />

                <Button
                    android:id="@+id/button_room_start"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/ui2_button_primary"
                    android:enabled="false"
                    android:text="@string/menu_start"
                    android:textAllCaps="false"
                    android:textColor="@color/ui2_button_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/room_bottom_nav"
        layout="@layout/comp_bottom_nav" />
</LinearLayout>
